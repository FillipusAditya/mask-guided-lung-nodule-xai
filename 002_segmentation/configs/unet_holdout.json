{
    "output": {
        "root_directory": "experiment_results"
    },
    "data": {
        "dataset_root": "000_dataset_v2/_segmentation_dataset",
        "split_method": "holdout_split",
        "metadata_filename": "001_holdout_split_lidc_lndb.csv",
        "fold": null,
        "image_path_column": "ct_parenchyma_path",
        "input_height": 512,
        "input_width": 512,
        "tile_grid_size": 5,
        "tile_overlap": 32,
        "tile_blend_mode": "hann"
    },
    "model": {
        "features": [16, 32, 64, 128]
    },
    "training": {
        "learning_rate": 1e-3,
        "batch_size": 8,
        "total_epochs": 100,
        "early_stopping_patience": 5,
        "seed": 42,
        "prediction_threshold": 0.5,
        "parallel_tile_processing": true,
        "tile_chunk_size": 16,
        "activation_checkpointing": false,
        "gradient_clip_max_norm": 1.0,
        "validation_on_gpu": true,
        "non_blocking_transfer": true
    },
    "loss": {
        "name": "BCEDiceLoss",
        "smooth": 1e-6
    },
    "optimizer": {
        "weight_decay": 0.0001
    },
    "scheduler": {
        "enabled": true,
        "name": "DiscreteReduceLROnPlateau",
        "learning_rates": [
            1e-3,
            5e-4,
            1e-4,
            5e-5,
            1e-5,
            5e-6,
            1e-6
        ],
        "patience": 2,
        "threshold": 0.0001
    },
    "dataloader": {
        "num_workers": 6,
        "persistent_workers": true,
        "prefetch_factor": 2,
        "train_shuffle": true
    },
    "amp": {
        "training_enabled": true
    },
    "checkpoint": {
        "resume_checkpoint_path": null
    }
}
